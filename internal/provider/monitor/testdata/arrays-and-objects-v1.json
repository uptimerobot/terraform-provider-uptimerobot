{
  "contract": "api-monitoring-v2/arrays-and-objects",
  "contractVersion": "arrays-and-objects/1.0.0",
  "fixtureSchemaVersion": 1,
  "sourceIssue": "UPT-3178",
  "asOf": "2026-07-22",
  "extends": "core-assertions/1.0.0",
  "wireContract": {
    "targetRepresentation": "native_json",
    "structuredTargetTypes": [
      "array",
      "object"
    ],
    "doubleEncoding": "A JSON string remains a string and is never reparsed as a structured target.",
    "targetDiscriminator": "none",
    "duplicateObjectKeys": "reject_before_lossy_parsing",
    "rawTextBoundaries": [
      "api-internal request rawBody",
      "dashboard structured-target editor",
      "terraform jsontypes.Normalized"
    ],
    "storage": "Persist the accepted target as the existing native JSON target field without schema changes.",
    "runtime": "Transport the accepted target as native JSON without an additional parse or discriminator."
  },
  "limits": {
    "targetSerializedBytes": 2048,
    "structuredTargetDepth": 16,
    "selectedValueDepth": 16,
    "selectedNodes": 100,
    "evaluationWorkUnits": 100000,
    "evaluationMillisecondsPerAssertion": 50,
    "actualSummaryCharacters": 256,
    "diagnosticBytesPerAssertion": 1024,
    "diagnosticBytesPerCheckResult": 8192
  },
  "numericPolicy": {
    "representation": "finite_ieee_754_binary64",
    "minimumSafeInteger": -9007199254740991,
    "maximumSafeInteger": 9007199254740991,
    "nonFinite": "reject",
    "integerOutsideSafeRange": "reject_at_input_boundary",
    "structuredEquality": "Numbers are equal when their finite IEEE-754 binary64 values are equal.",
    "negativeZero": "equal_to_zero",
    "stringCoercion": "none",
    "existingScalarComparisons": "unchanged by this contract"
  },
  "comparisonMatrix": [
    {
      "comparison": "equals",
      "sources": [
        "body_json"
      ],
      "target": "Any non-null JSON value. Structured targets use strict recursive equality.",
      "structuredSemantics": "Object key order is ignored, object key sets are exact, array order is preserved, and JSON types are not coerced."
    },
    {
      "comparison": "not_equals",
      "sources": [
        "body_json"
      ],
      "target": "Any non-null JSON value.",
      "structuredSemantics": "Exact logical negation of equals."
    },
    {
      "comparison": "contains",
      "sources": [
        "body_json"
      ],
      "target": "Any JSON value for an array, an object for an object, or a string for a string.",
      "structuredSemantics": "Arrays contain an exact element. Objects contain an expected-object recursive subset. Existing string substring behavior is unchanged."
    },
    {
      "comparison": "not_contains",
      "sources": [
        "body_json"
      ],
      "target": "Same target rules as contains.",
      "structuredSemantics": "Exact logical negation of contains after the selected value and target types are valid."
    },
    {
      "comparison": "is_empty",
      "sources": [
        "body_json"
      ],
      "target": "omitted",
      "selectedTypes": [
        "array",
        "object"
      ]
    },
    {
      "comparison": "is_not_empty",
      "sources": [
        "body_json"
      ],
      "target": "omitted",
      "selectedTypes": [
        "array",
        "object"
      ]
    },
    {
      "comparison": "length_equals",
      "sources": [
        "body_json"
      ],
      "target": "non-negative safe integer",
      "selectedTypes": [
        "array",
        "object"
      ]
    },
    {
      "comparison": "length_not_equals",
      "sources": [
        "body_json"
      ],
      "target": "non-negative safe integer",
      "selectedTypes": [
        "array",
        "object"
      ]
    },
    {
      "comparison": "length_greater_than",
      "sources": [
        "body_json"
      ],
      "target": "non-negative safe integer",
      "selectedTypes": [
        "array",
        "object"
      ]
    },
    {
      "comparison": "length_less_than",
      "sources": [
        "body_json"
      ],
      "target": "non-negative safe integer",
      "selectedTypes": [
        "array",
        "object"
      ]
    }
  ],
  "semantics": {
    "objectEquality": "unordered_keys_exact_key_set",
    "arrayEquality": "ordered_exact_elements",
    "arrayContains": "one_element_strictly_equals_target",
    "objectContains": "every_expected_key_exists_and_each_expected_value_recursively_matches; nested expected objects are subsets and arrays are exact",
    "multiMatch": "all selected JSONPath values must pass",
    "missing": "No selected value keeps the Core no-match behavior.",
    "null": "Null remains distinct from missing and from arrays or objects.",
    "depth": "The root array or object has depth 1; each nested array or object adds 1; scalars do not add depth.",
    "objectLength": "number_of_own_keys",
    "arrayLength": "number_of_elements",
    "stringBehavior": "unchanged; new empty and length comparisons do not apply to strings",
    "featureGate": "reuse_existing_core_rollout_controls",
    "newFeatureGate": false
  },
  "diagnostics": {
    "contractVersion": "assertion-diagnostics/1.0.0",
    "envelopeVersion": 1,
    "newEnvelopeRequired": false,
    "arraySummary": "[array length=<n>]",
    "objectSummary": "[object fields=<n>]",
    "fullStructuredValues": "never_emit",
    "failureReasons": "Use the existing open failure-reason field and existing limit reasons; enum additions do not change the envelope."
  },
  "consumerAreas": {
    "monitoring-core-go": [
      "validation",
      "evaluation",
      "limits",
      "diagnostics"
    ],
    "api-internal": [
      "wire",
      "validation",
      "persistence",
      "openapi"
    ],
    "dashboard": [
      "raw_text_validation",
      "editor",
      "serialization",
      "diagnostics"
    ],
    "terraform-provider-uptimerobot": [
      "raw_text_validation",
      "round_trip",
      "documentation"
    ],
    "qa-automation": [
      "cross_service_conformance"
    ]
  },
  "fixtureSemantics": {
    "copyPolicy": "Files with this contractVersion remain byte-identical in every consumer repository.",
    "generatedInput": "A generated object describes deterministic data that a repository-native test constructs instead of storing a very large literal.",
    "expectedMatching": "Expected fields are partial unless a case explicitly declares an exact payload.",
    "execution": "Downstream implementation tasks execute the areas they own; UPT-3178 consumers verify identity, limits, comparison inventory, and required case coverage."
  },
